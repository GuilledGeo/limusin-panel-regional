# Proveedor de IA para Limusin GPT: "groq" (gratis), "gemini" o "anthropic"
AI_PROVIDER=groq

# Groq (gratis — console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (Google AI Studio — cuenta de empresa)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (opcional, si AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
